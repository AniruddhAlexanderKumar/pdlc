{
  "name": "@sv/server",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/index.ts",
    "dev:db": "tsx src/scripts/dev-db.ts",
    "build": "node build.mjs",
    "test": "node --import tsx --test test/*.test.ts",
    "start": "node --enable-source-maps dist/index.js",
    "migrate": "tsx --env-file-if-exists=../../.env src/scripts/migrate.ts",
    "create-admin": "tsx --env-file-if-exists=../../.env src/scripts/create-admin.ts",
    "typecheck": "tsc --noEmit",
    "smoke": "node scripts/smoke.mjs"
  },
  "dependencies": {
    "cookie-parser": "^1.4.7",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "kysely": "^0.29.7",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "zod": "^4.6.7",
    "@sv/shared": "*"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/pg": "^8.23.1",
    "embedded-postgres": "^18.4.0-beta.17",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15"
  }
}
