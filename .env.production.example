# Used by docker-compose.yml. Copy to .env.production and fill in.
APP_URL=https://velocity.yourcompany.com
# Stable secret for one-time demo IP fingerprints (at least 32 characters).
# Keep this value stable across deployments to preserve the per-IP one-time limit.
DEMO_IP_HASH_SECRET=replace-with-a-long-random-secret
POSTGRES_PASSWORD=change-me-to-a-long-random-string
# false = invite-only (recommended). The first account can always be created.
ALLOW_SIGNUP=false
TRUST_PROXY=1
