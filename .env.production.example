# Used by docker-compose.yml. Copy to .env.production and fill in.
APP_URL=https://velocity.yourcompany.com
POSTGRES_PASSWORD=change-me-to-a-long-random-string
# false = invite-only (recommended). The first account can always be created.
ALLOW_SIGNUP=false
TRUST_PROXY=1
# Default retains legacy auto-migration. Set false only after a separately authorized
# migration job and runtime-role read access to kysely_migration are in place.
# MIGRATIONS_ON_STARTUP=false

# Configure these through the protected production environment to enable reset emails.
# RESET_SMTP_HOST=smtp.example.com
# RESET_SMTP_PORT=587
# RESET_SMTP_SECURE=false
# RESET_SMTP_FROM=security@example.com
# RESET_SMTP_USER=
# RESET_SMTP_PASSWORD=

# Google AI Studio assistant: configure only through protected backend environment settings.
# ASSISTANT_AI_ENABLED=true
# ASSISTANT_GEMINI_MODEL=your-supported-gemini-model
# ASSISTANT_GEMINI_API_KEY_1=
# ASSISTANT_GEMINI_API_KEY_2=
# ASSISTANT_GEMINI_API_KEY_3=
# ASSISTANT_GEMINI_API_KEY_4=

# Optional AI/ML API assistant provider (primary; Gemini keys then act as fallbacks).
# Store the replacement key in protected backend environment settings only.
# ASSISTANT_AIMLAPI_KEY=
# ASSISTANT_AIMLAPI_MODEL=openai/gpt-5-5

# OpenRouter assistant provider, after AI/ML API and before Gemini when configured.
# Configure both values in the protected backend environment.
# ASSISTANT_OPENROUTER_KEY=
# ASSISTANT_OPENROUTER_MODEL=your-openrouter-model-id
