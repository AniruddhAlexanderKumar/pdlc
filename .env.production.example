# Used by docker-compose.yml. Copy to .env.production and fill in.
APP_URL=https://velocity.yourcompany.com
POSTGRES_PASSWORD=change-me-to-a-long-random-string
# false = invite-only (recommended). The first account can always be created.
ALLOW_SIGNUP=false
TRUST_PROXY=1

# Configure these through the protected production environment to enable reset emails.
# RESET_SMTP_HOST=smtp.example.com
# RESET_SMTP_PORT=587
# RESET_SMTP_SECURE=false
# RESET_SMTP_FROM=security@example.com
# RESET_SMTP_USER=
# RESET_SMTP_PASSWORD=

# Google AI Studio assistant: configure only through protected backend environment settings.
# ASSISTANT_AI_ENABLED=true
# ASSISTANT_GEMINI_MODEL=your-supported-gemini-model
# ASSISTANT_GEMINI_API_KEY_1=
# ASSISTANT_GEMINI_API_KEY_2=
# ASSISTANT_GEMINI_API_KEY_3=
# ASSISTANT_GEMINI_API_KEY_4=
