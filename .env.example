# ── Solution Velocity configuration ─────────────────────────────────────────
# Copy to .env and adjust. Every variable is validated at startup (apps/server/src/config.ts).

NODE_ENV=development
PORT=4000

# Public URL people open in the browser. Used for invite/reset links and the CSRF check.
# In production this must be your real https:// URL, e.g. https://velocity.yourcompany.com
APP_URL=http://localhost:5173

# Your PostgreSQL database. For local dev, `npm run dev:db` runs one at this address.
# For a remote database with TLS add ?sslmode=require
DATABASE_URL=postgres://velocity:velocity@localhost:5433/velocity
DATABASE_POOL_MAX=10

# Stable secret for one-time demo IP fingerprints (at least 32 characters).
# Set a persistent random value; rotating it allows previously-seen IPs to start a new demo.
# DEMO_IP_HASH_SECRET=

# Days a login lasts (renewed while in use).
SESSION_TTL_DAYS=30

# true: anyone can create an account (and their own workspace).
# false: invite-only. The very first account can always be created.
ALLOW_SIGNUP=true

# Set to 1 when running behind a reverse proxy (nginx, Caddy, a load balancer).
TRUST_PROXY=0

LOG_LEVEL=info

# "rules" (built in) or "ai" once an AI provider is implemented (apps/server/src/services/insights.ts).
INSIGHTS_PROVIDER=rules
# AI_API_KEY=
# AI_MODEL=
