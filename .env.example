# -----------------------------------------------------------------------------
# PDLC Platform — Environment Variables
# Copy this file to `.env.local` (development) and fill in real values.
# All variables are validated at startup by src/config/env.ts (see that file
# for the authoritative schema). The app will refuse to boot if a required
# variable is missing or malformed.
# -----------------------------------------------------------------------------

# Runtime mode. Next.js sets this automatically for `dev`/`build`/`start`;
# only override it for local scripts or tooling that need an explicit value.
# One of: development | test | production
NODE_ENV=development

# PostgreSQL connection string. This is the only supported database — the
# schema uses PostgreSQL-native enums and the client connects through the
# `@prisma/adapter-pg` driver adapter (see src/lib/db.ts). There is no SQLite
# or in-memory fallback anywhere, in development or in tests.
#
# Format: postgresql://<user>:<password>@<host>:<port>/<database>?schema=public
#
# The value below matches the container in docker-compose.yml, so
# `docker compose up -d` and this line work together out of the box. If you
# changed PDLC_DB_PORT, change the port here to match.
#
# In production this is supplied by the environment (never committed), and the
# credentials in it are secrets: keep them out of the repository, out of CI
# logs, and out of `.env.example`.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/pdlc_dev?schema=public"

# Minimum severity written by the structured logger (src/lib/logger.ts).
# One of: debug | info | warn | error
LOG_LEVEL=info

# Public application name, safe to expose to the browser (NEXT_PUBLIC_ vars
# are inlined into client bundles — never put secrets behind this prefix).
NEXT_PUBLIC_APP_NAME="PDLC Platform"

# -----------------------------------------------------------------------------
# Authentication
# -----------------------------------------------------------------------------

# How long a session stays valid, in days. Expiry is enforced server-side
# against the stored session row; the cookie lifetime is only a hint to the
# browser. Optional — defaults to 30.
SESSION_TTL_DAYS=30

# Note: there is no auth signing secret to configure. Sessions are opaque
# random tokens stored (hashed) in PostgreSQL, not signed JWTs, so there is no
# key that could leak or need rotating.

# -----------------------------------------------------------------------------
# Development bootstrap (used ONLY by `npm run db:seed`, never by the app)
# -----------------------------------------------------------------------------
# The seed refuses to run without these — it will not invent a password, so no
# well-known credential can ever reach a deployed database. Choose your own
# values locally; the password must be at least 12 characters.
#
# For anything other than local development, register through /sign-up instead
# of seeding an account.
SEED_ORGANIZATION_NAME="Example Aerospace"
SEED_ADMIN_NAME="Development Engineer"
SEED_ADMIN_EMAIL="engineer@example.test"
SEED_ADMIN_PASSWORD=""
